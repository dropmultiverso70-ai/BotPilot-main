{
  "name": "botia",
  "version": "1.0.3",
  "type": "module",
  "productName": "BOT.IA",
  "description": "Aplicativo desktop local para chat com modelos Ollama, memória, skills e agente configurável.",
  "author": "BOT.IA",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "start": "electron .",
    "test": "node --test test/*.js",
    "lint": "eslint . --ext .js",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:dir": "npm run build && electron-builder --win nsis --dir --publish never"
  },
  "build": {
    "appId": "com.botia.app",
    "productName": "BOT.IA",
    "icon": "build/icon.svg",
    "artifactName": "BOT.IA-Setup-${version}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "removePackageScripts": true,
    "win": {
      "target": "nsis",
      "artifactName": "BOT.IA-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BOT.IA",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "BOT.IA-Setup-${version}.${ext}"
    }
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  }
}
